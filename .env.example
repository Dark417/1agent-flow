# ---------------------------------------------------------------------------
# Copy this file to `.env` and replace the placeholders with your real values.
# `.env` is gitignored. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# === Google ADK (Gemini) ===================================================
# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
# Use Google AI Studio (FALSE) rather than Vertex AI (TRUE)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# Default model used by the examples
GOOGLE_MODEL=gemini-2.0-flash

# === Amazon Strands Agents (Bedrock) =======================================
# Standard AWS credentials (or use an AWS profile / IAM role instead)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=us-east-1
# Optional: a Bedrock bearer token instead of access keys
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-bearer-token-here
# Default Bedrock model id used by the examples
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
